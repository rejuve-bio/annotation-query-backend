# Template for .env.production — used by docker-compose.prod.yml.
# Copy to .env.production and fill in real values. Never commit the
# populated file.
#
# Unlike docker-compose.yml (dev), the prod compose file does not bind-mount
# the repo into the container, so this file's values only ever reach the
# app as process environment variables — the file itself is never exposed
# inside the container's filesystem.

# ──────────────────────────────────────────────
# Neo4j (Human / HGNC)
# ──────────────────────────────────────────────
HUMAN_NEO4J_URI=bolt://your-neo4j-host:7687
HUMAN_NEO4J_USERNAME=neo4j
HUMAN_NEO4J_PASSWORD=your_password

# Optional — leave commented out if Drosophila (fly) data is not available.
# FLY_NEO4J_URI=bolt://your-fly-neo4j-host:7688
# FLY_NEO4J_USERNAME=neo4j
# FLY_NEO4J_PASSWORD=your_password

# ──────────────────────────────────────────────
# MongoDB
# ──────────────────────────────────────────────
MONGO_URI=mongodb://mongodb:27017/annotation_db
MONGODB_DOCKER_PORT=27017

# ──────────────────────────────────────────────
# Redis — auth is required in production (see docker-compose.prod.yml's
# "redis-server --requirepass" command). Both URLs must embed the same
# password.
# ──────────────────────────────────────────────
REDIS_PASSWORD=change_me_to_a_long_random_value
REDIS_URL=redis://:change_me_to_a_long_random_value@redis:6379/0
REDIS_URL_BROKER=redis://:change_me_to_a_long_random_value@redis:6379/1
REDIS_EXPIRATION=3600
REDIS_DOCKER_PORT=6380

# ──────────────────────────────────────────────
# Auth
# ──────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_value
SECRET_KEY=change_me_to_a_long_random_value
SHARED_TOKEN_SECRET=change_me_to_a_long_random_value

# ──────────────────────────────────────────────
# LLM / Summary
# ──────────────────────────────────────────────
# Supported values: openai, gemini
LLM_MODEL=openai
OPENAI_API_KEY=your_openai_api_key
# GEMINI_API_KEY=your_gemini_api_key

# ──────────────────────────────────────────────
# Elasticsearch (optional)
# ──────────────────────────────────────────────
# ES_URL=https://your-elasticsearch-host:9200
# ES_API_KEY=your_es_api_key

# ──────────────────────────────────────────────
# MORK / MORK CLI
# ──────────────────────────────────────────────
MORK_URL=http://mork-sample:8027
MORK_DATA_DIR=/mnt/hdd_1/biocypher-kg/output/hsa/metta_out_v6
# FLY_MORK_DATA_DIR=/mnt/hdd_1/biocypher-kg/output/dmel/metta

# ──────────────────────────────────────────────
# Application / Docker
# ──────────────────────────────────────────────
APP_PORT=8000
APP_BASE_URL=https://your-public-domain.example
DOCKER_HUB_REPO=your-dockerhub-username/annotation:staging
COMPOSE_PROJECT_NAME=annotation-query-backend-prod

# Caddy reverse proxy
CADDY_PORT=443
CADDY_PORT_FORWARD=8000

# ──────────────────────────────────────────────
# Search
# ──────────────────────────────────────────────
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=change_me_to_a_long_random_value
MEILI_PORT=7700

# ──────────────────────────────────────────────
# Email
# ──────────────────────────────────────────────
MAIL_SERVER=your-smtp-host
MAIL_PORT=587
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password
MAIL_DEFAULT_SENDER=noreply@your-domain.example
MAIL_USE_TLS=True
MAIL_USE_SSL=False

# ──────────────────────────────────────────────
# Feature flags  (shown with their defaults)
# ──────────────────────────────────────────────
DEDUP_ENABLED=true

# ──────────────────────────────────────────────
# Tuning  (shown with their defaults — safe to omit)
# ──────────────────────────────────────────────
# TASK_STALE_SECS=2400       # drop tasks older than this many seconds
# MAX_SLOW_QUEUE=20           # reject slow queries when queue depth >= this
# MAX_BINDING_VALS=1000       # cap per-variable binding list size in Cypher queries
# MAX_COMBOS=50000            # cap Cartesian product size in Cypher queries
